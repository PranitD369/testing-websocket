# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Server
PORT=3000
LOG_LEVEL=info

# Gemini models
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_REST_MODEL=gemini-2.5-flash

# Heartbeat (ms)
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_TIMEOUT_MS=25000

# Reconnect
MAX_RECONNECT_ATTEMPTS=8

# Degradation thresholds (RTT ms)
DEGRADATION_RTT_LD_MS=200
DEGRADATION_RTT_AUDIO_MS=500
DEGRADATION_RTT_PHOTO_MS=1500

# Session
SESSION_TTL_HOURS=24
CONTEXT_COMPRESS_TRIGGER_TOKENS=25000

# Optional Live API features. The gemini-2.5-flash-native-audio-* family does NOT
# currently support these and will close the WS with 1011 on the first turn.
# Enable when using a model that does support them.
ENABLE_SESSION_RESUMPTION=false
ENABLE_CONTEXT_COMPRESSION=false

# Durable session store (Postgres). Leave empty for in-memory only (no cross-restart durability).
# Local Docker:  DATABASE_URL=postgres://postgres:lab@localhost:5432/lab
# Supabase:      DATABASE_URL=postgres://postgres:[PWD]@db.[PROJECT].supabase.co:5432/postgres
# See docs/database.md for setup.
DATABASE_URL=
DB_POOL_MAX=10

# Hybrid context replay: how many of the most-recent turns get replayed verbatim to
# Gemini after setupComplete. Older turns are summarized as systemInstruction.
CONTEXT_REPLAY_TAIL_TURNS=3
