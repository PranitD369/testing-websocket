{
  "name": "gemini-live-reliability-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Backend reliability lab for proxying Gemini Live API over WebSocket with heartbeat, reconnect, session resumption, graceful degradation, and photo-based fallback.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.2",
    "@fastify/websocket": "^11.0.1",
    "@google/genai": "^0.7.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "nanoid": "^5.0.9",
    "pg": "^8.21.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
