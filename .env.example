# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Server
PORT=3000
LOG_LEVEL=info

# Gemini models
GEMINI_LIVE_MODEL=gemini-2.5-flash-live-preview
GEMINI_REST_MODEL=gemini-2.5-flash

# Heartbeat (ms)
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_TIMEOUT_MS=25000

# Reconnect
MAX_RECONNECT_ATTEMPTS=8

# Degradation thresholds (RTT ms)
DEGRADATION_RTT_LD_MS=200
DEGRADATION_RTT_AUDIO_MS=500
DEGRADATION_RTT_PHOTO_MS=1500

# Session
SESSION_TTL_HOURS=24
CONTEXT_COMPRESS_TRIGGER_TOKENS=25000
